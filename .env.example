# ===================================================
# YOUTUBE MUSIC INTEGRATION (RECOMMENDED SETUP)
# ===================================================
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Enable "YouTube Data API v3" under APIs & Services > Library
# 3. Create an API Key under APIs & Services > Credentials
# 4. Create a playlist on music.youtube.com (Public or Unlisted) and copy its ID from the URL (after list=)

VITE_YOUTUBE_API_KEY=your_google_api_key_here
VITE_YOUTUBE_PLAYLIST_ID=your_youtube_music_playlist_id_here

# ===================================================
# OPTIONAL: GOOGLE OAUTH (FOR PRIVATE LIKED MUSIC 'LM')
# ===================================================
# Run: node scripts/get-youtube-token.mjs to generate the refresh token

VITE_YOUTUBE_CLIENT_ID=
VITE_YOUTUBE_CLIENT_SECRET=
VITE_YOUTUBE_REFRESH_TOKEN=
